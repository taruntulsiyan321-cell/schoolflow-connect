# Data exports taken before a destructive migration (Chunk 3.5 dropped
# library_books, library_checkouts, staff_attendance). These hold real staff
# attendance dates and are kept OUTSIDE the repo — git history is forever.
docs/data-exports/

# tsc -b writes these beside each tsconfig; `npm run typecheck` is build mode
# since 10.7 group 1, so they appear on every typecheck run. Build output.
*.tsbuildinfo
.eslint-baseline-report.json

# throwaway probe output from the evidence harness
/e2e-evidence/scratch/

# Transient status file written by the offline push-retry loop.
push-status.txt
*.bundle

# Vercel local build/link state (from the landing-page work on main).
.vercel

# Claude Code's per-machine settings. This file holds a live SUPABASE_ACCESS_TOKEN
# in its permission entries, and until 2026-09-09 the only thing keeping it out of
# a commit was a rule in the USER's global ~/.config/git/ignore — which does not
# travel with the repository. On any other machine it was one `git add -A` away
# from being committed.
.claude/settings.local.json
