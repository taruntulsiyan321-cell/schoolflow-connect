# Copy to .env.local and fill ONE option.

# ── OpenRouter → Qwen 3.7 Flash (primary generative path via modelRouter) ──
# Get key: https://openrouter.ai/keys
# NEVER commit the real key. Set server-side / local env only:
#   OPENROUTER_API_KEY=sk-or-...
# Supabase Edge secrets (production):
#   npx supabase secrets set OPENROUTER_API_KEY=sk-or-... --project-ref <ref>
# Optional model override (default qwen/qwen3.7-flash):
#   OPENROUTER_MODEL=qwen/qwen3.7-flash
# Local connectivity test (does not print the key):
#   npm run ai:ping

# OpenRouter is the only AI provider (explain, battle reports, plans, DPP
# gen, and every agent under supabase/functions/_shared/ all route through
# it via structuredCompletion.ts / modelRouter.ts) — no second provider key
# needed.

# Option A: https://supabase.com/dashboard/account/tokens → New token
SUPABASE_ACCESS_TOKEN=

# Option B: Supabase → Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.imrsjhftejghcrhzdjrl:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Then run:
#   npm run db:migrate          — apply pending migrations only
#   npm run db:check-migrations — see what is still missing
#   npm run db:seed             — demo data only (if migrate already ran)
